{
  "name": "mxw01-thermal-printer",
  "version": "0.1.0",
  "description": "MXW01 Print Studio: cross-platform thermal-printer library, document renderer and local web terminal",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "UPSTREAM.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "hardware:test-print": "npm run build && node scripts/hardware-test-print.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:conformance": "npm run build && node scripts/verify-rendering-vectors.mjs && node scripts/verify-fingerprint-vectors.mjs",
    "test:fingerprint": "npm run build && node scripts/verify-fingerprint-vectors.mjs",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "web:smoke": "node scripts/web-smoke-test.mjs",
    "web:e2e": "node scripts/web-e2e-smoke.mjs",
    "web:dev": "npm run build && node scripts/local-web-server.mjs"
  },
  "keywords": [
    "thermal-printer",
    "mxw01",
    "bluetooth",
    "web-bluetooth",
    "printer",
    "nodejs",
    "bun",
    "react",
    "vue",
    "platform-agnostic",
    "framework-agnostic"
  ],
  "author": "Dowser contributors",
  "contributors": [
    {
      "name": "Clément Van Peuter",
      "url": "https://github.com/clementvp"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dowser/mxw01-print-studio.git"
  },
  "bugs": {
    "url": "https://github.com/Dowser/mxw01-print-studio/issues"
  },
  "homepage": "https://github.com/Dowser/mxw01-print-studio#readme",
  "peerDependencies": {
    "@stoprocent/noble": "^1.15.0"
  },
  "peerDependenciesMeta": {
    "@stoprocent/noble": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "happy-dom": "20.0.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^1.0.0"
  }
}
